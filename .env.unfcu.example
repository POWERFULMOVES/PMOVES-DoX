# UNFCU Edition Environment Variables
# Copy to .env and fill in real values before deployment.
# Generate JWT secret with: openssl rand -base64 64

# Required: JWT authentication secret (must match Supabase project secret)
SUPABASE_JWT_SECRET=REPLACE_ME_WITH_64_CHAR_SECRET
JWT_SECRET=REPLACE_ME_WITH_64_CHAR_SECRET

# Optional: Supabase connection (if using Supabase backend instead of SQLite)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key

# Optional: LLM provider for tag extraction
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Optional: HuggingFace token for model downloads
# HUGGINGFACE_HUB_TOKEN=hf_xxx

# Optional: NATS for event bus (default: standalone mode)
# NATS_URL=nats://nats:pmoves@nats:4222
# NATS_TLS_ENABLED=true
